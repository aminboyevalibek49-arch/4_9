<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fast Food</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-dark bg-danger">
    <div class="container flex-column align-items-start">
      <a class="navbar-brand fw-bold" href="#"> Fast Food</a>
      <button class="btn btn-light btn-sm mb-2" data-bs-toggle="modal" data-bs-target="#addModal">
        + Add Product
      </button>
    </div>
  </nav>

  <!-- Add Modal -->
  <div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form method="POST" action="/products/add_product">
          <div class="modal-header">
            <h5 class="modal-title">Add Product</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="text" class="form-control mb-3" placeholder="Name..." name="title" required />
            <input type="text" class="form-control mb-3" placeholder="Price..." name="price" required />
            <input type="text" class="form-control" placeholder="Description..." name="desc" required />
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-danger">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Products -->
  <div class="container my-4">
    <h4 class="mb-3">Products</h4>
    <div class="row g-3">
      <% products.forEach(function(product){ %>
      <div class="col-md-4">
        <div class="card">
          <img src="https://picsum.photos/seed/<%= product.id %>/400/200" class="card-img-top" alt="..." />
          <div class="card-body">
            <h5 class="card-title"><%= product.title %></h5>
            <p class="card-text text-muted"><%= product.desc %></p>
            <p class="fw-bold text-danger"><%= product.price %> sum</p>
            <div class="d-flex gap-2">
              <button class="btn btn-outline-secondary btn-sm"
                data-bs-toggle="modal"
                data-bs-target="#viewModal<%= product.id %>">
                View
              </button>
              <a href="/products/delete/<%= product.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Delete</a>
            </div>
          </div>
        </div>
      </div>

      <!-- View Modal -->
      <div class="modal fade" id="viewModal<%= product.id %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title"><%= product.title %></h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
              <img src="https://picsum.photos/seed/<%= product.id %>/400/200" class="img-fluid rounded mb-3" alt="..." />
              <p class="text-muted"><%= product.desc %></p>
              <p class="fw-bold text-danger fs-5"><%= product.price %> sum</p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>